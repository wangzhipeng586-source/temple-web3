# PostgreSQL。docker compose 默认账号与此一致。
DATABASE_URL=postgresql://temple:temple@localhost:5432/temple?schema=public

# 对外访问地址，用于 OAuth 回调与 Stripe 回跳。不要以斜杠结尾。
APP_URL=http://localhost:3000

# 真实 Google / Apple 登录时用来签名 OAuth state。至少 16 位。生产环境务必更换。
AUTH_SECRET=please-change-this-dev-secret

# 未配置对应密钥时：true 走模拟登录页，false 则按钮提示未配置。
OIDC_MOCK=true

# Google OAuth（OIDC）。留空则使用模拟登录（当 OIDC_MOCK 不是 false）。
# 控制台回调：${APP_URL}/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In。需要 Services ID，以及预先生成的 client_secret（JWT）
# 或同时提供 TEAM_ID、KEY_ID、PRIVATE_KEY（PKCS8 PEM，换行写成 \n）以在运行时签名。
# 回调：${APP_URL}/auth/callback/apple
# Apple 要求 response_mode=form_post，state 放在签名参数里，不依赖跨站 Cookie。
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# 支付。未配置 STRIPE_SECRET_KEY 时只走模拟支付。
# PAYMENT_ALLOW_MOCK=false 可在生产关闭「模拟支付成功」。
PAYMENT_ALLOW_MOCK=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook：${APP_URL}/api/payments/stripe/webhook
# 事件：checkout.session.completed
